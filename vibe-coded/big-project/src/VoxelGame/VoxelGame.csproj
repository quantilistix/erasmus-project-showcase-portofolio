<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Compile optimized methods on first use in Release; avoid promotion work during play. -->
    <TieredCompilation Condition="'$(Configuration)' == 'Release'">false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VoxelTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MYT.Kit/MYT.Kit.csproj" />
    <ProjectReference Include="../VoxelLighting/VoxelLighting.csproj" />
  </ItemGroup>

</Project>
