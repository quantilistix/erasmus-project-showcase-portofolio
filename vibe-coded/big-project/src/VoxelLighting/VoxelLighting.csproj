  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GlmSharp" Version="0.9.8" />
    <InternalsVisibleTo Include="VoxelGame" />
    <InternalsVisibleTo Include="VoxelTests" />
  </ItemGroup>
</Project>
