#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
layout(local_size_x=64) in;
struct DamageRequest { dvec4 inputData; dvec4 stress; dvec4 material; dvec4 limits; };
layout(std430,binding=9) readonly buffer Requests { DamageRequest requests[]; };
layout(std430,binding=10) writeonly buffer Results { dvec4 results[]; };
layout(push_constant) uniform Parameters { uvec4 counts; vec4 physics; uvec4 batch; } p;
void main() {
    uint i=gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*gl_NumWorkGroups.x*gl_WorkGroupSize.x;
    if(i>=p.batch.y) return;
    DamageRequest r=requests[i];
    double health=r.inputData.x,amount=r.inputData.y;
    int mode=int(r.material.w);
    if(r.limits.w>0.5) amount=0.0LF;
    else if(mode!=0) {
        dvec3 stress=r.stress.xyz;
        if(mode==1) stress+=dvec3(0.0LF,r.inputData.z,r.inputData.z*0.5LF);
        dvec3 ratios=stress/(r.limits.xyz*(r.material.y*health));
        double ratio=max(ratios.x,max(ratios.y,ratios.z));
        if(!(ratio>1.0LF)) amount=0.0LF;
        else if(mode==1) amount=r.material.z*r.inputData.w*(1.0LF-1.0LF/(ratio*ratio))*r.stress.w;
        else amount=r.stress.w*max(r.inputData.y,0.5LF*r.material.x*r.material.y)*(ratio*ratio-1.0LF);
    }
    double squared=health*health-2.0LF*amount/(r.material.x*r.material.y);
    double next=amount>0.0LF ? (squared>0.0LF ? sqrt(squared) : 0.0LF) : health;
    results[i]=dvec4(next,clamp(roundEven((1.0LF-next)*65535.0LF),0.0LF,65535.0LF),max(amount,0.0LF),0.0LF);
}
