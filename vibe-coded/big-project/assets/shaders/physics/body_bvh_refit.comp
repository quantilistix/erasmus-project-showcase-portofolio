#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_GOOGLE_include_directive : require

// Refit the top-level body hierarchy to the current swept bounds before broad-phase queries.
// As with the soft-body BVHs, the second child to arrive merges and climbs to its parent.
#define BODY_BVH_QUALIFIER coherent
layout(local_size_x = 64) in;

#include "solver_common.glsl"
#include "contact_common.glsl"

void main()
{
    uint node = gl_GlobalInvocationID.x;
    if (node >= rangeCount)
        return;
    uint count = floatBitsToUint(bodyBvhNodes[node].boundsMax.w);
    if (count == 0u)
        return;

    uint first = floatBitsToUint(bodyBvhNodes[node].boundsMin.w);
    vec3 lower = vec3(3.0e38);
    vec3 upper = vec3(-3.0e38);
    for (uint i = 0u; i < count; i++)
    {
        uint body = bodyBvhPrimitives[first + i];
        lower = min(lower, bodies[body].boundsMin.xyz);
        upper = max(upper, bodies[body].boundsMax.xyz);
    }
    bodyBvhNodes[node].boundsMin.xyz = lower;
    bodyBvhNodes[node].boundsMax.xyz = upper;

    for (;;)
    {
        uint parent = bodyBvhRefit[node].x;
        if (parent == NO_BLOCK)
            return;
        memoryBarrierBuffer();
        if (atomicAdd(bodyBvhRefit[parent].y, 1u) == 0u)
            return;
        memoryBarrierBuffer();
        bodyBvhRefit[parent].y = 0u;
        uint right = floatBitsToUint(bodyBvhNodes[parent].boundsMin.w);
        bodyBvhNodes[parent].boundsMin.xyz = min(bodyBvhNodes[parent + 1u].boundsMin.xyz, bodyBvhNodes[right].boundsMin.xyz);
        bodyBvhNodes[parent].boundsMax.xyz = max(bodyBvhNodes[parent + 1u].boundsMax.xyz, bodyBvhNodes[right].boundsMax.xyz);
        node = parent;
    }
}
