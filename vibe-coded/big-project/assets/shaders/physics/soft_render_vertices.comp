#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_GOOGLE_include_directive : require

// Writes one soft body's render vertices from its solved nodes: position plus a smooth
// normal gathered from the surface triangles around the vertex (area-weighted). Gathering
// per vertex avoids float atomics, which would need VK_EXT_shader_atomic_float.

layout(local_size_x = 64) in;

#include "solver_common.glsl"

// Set 1: this body's render buffers. Indices are body-local; rangeOffset is the body's first node.
layout(std430, set = 1, binding = 0) buffer RenderVertices { float renderVertices[]; };
layout(std430, set = 1, binding = 1) readonly buffer SurfaceTriangles { uint triangleIndices[]; };
layout(std430, set = 1, binding = 2) readonly buffer VertexTriangleOffsets { uint vertexTriangleOffsets[]; };
layout(std430, set = 1, binding = 3) readonly buffer VertexTriangleIndices { uint vertexTriangleIndices[]; };

dvec3 nodePosition(uint localIndex)
{
    return nodes[rangeOffset + localIndex].position.xyz;
}

void main()
{
    uint v = gl_GlobalInvocationID.x;
    if (v >= rangeCount)
        return;

    dvec3 normal = dvec3(0.0);
    for (uint i = vertexTriangleOffsets[v]; i < vertexTriangleOffsets[v + 1]; i++)
    {
        uint t = vertexTriangleIndices[i];
        dvec3 a = nodePosition(triangleIndices[3 * t]);
        dvec3 b = nodePosition(triangleIndices[3 * t + 1]);
        dvec3 c = nodePosition(triangleIndices[3 * t + 2]);
        normal += cross(b - a, c - a);
    }

    double normalLength = length(normal);
    vec3 n = normalLength > 1e-12 ? vec3(normal / normalLength) : vec3(0.0, 0.0, 1.0);
    vec3 p = vec3(nodePosition(v));

    uint base = v * 6;
    renderVertices[base + 0] = p.x;
    renderVertices[base + 1] = p.y;
    renderVertices[base + 2] = p.z;
    renderVertices[base + 3] = n.x;
    renderVertices[base + 4] = n.y;
    renderVertices[base + 5] = n.z;
}
