#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_GOOGLE_include_directive : require

// Copy the live reports, rather than the entire report capacity, to mapped host memory.
// One group also runs for an empty buffer so the header is always refreshed.
layout(local_size_x = 64) in;

#include "solver_common.glsl"
#include "contact_common.glsl"

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i == 0u)
        readbackReportCounts = reportCounts;
    if (i < min(reportCounts.x, uint(reports.length())))
        readbackReports[i] = reports[i];
}
