#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_GOOGLE_include_directive : require

// Implicit Euler velocities from the solved positions: v = (x - x^t) / h (VBD Eq. 6).

layout(local_size_x = 64) in;

#include "solver_common.glsl"

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    uint nodeCount = counts.x;
    double h = gravityAndStep.w;

    if (gid < nodeCount)
    {
        Node node = nodes[gid];
        nodes[gid].previousVelocity = node.velocity;
        nodes[gid].velocity = isPinned(node) ? dvec4(0.0) : dvec4((node.position.xyz - node.previous.xyz) / h, 0.0);
        return;
    }

    uint r = gid - nodeCount;
    if (r >= counts.y)
        return;

    Rigid body = rigids[r];
    rigids[r].previousLinearVelocity = body.linearVelocity;
    rigids[r].linearVelocity = dvec4((body.position.xyz - body.previousPosition.xyz) / h, 0.0);
    rigids[r].angularVelocity = dvec4(quatDifference(body.orientation, body.previousOrientation) / h, 0.0);
    rigids[r].inertia1.w = double(rigidColors[flags * counts.y + r]);
}
