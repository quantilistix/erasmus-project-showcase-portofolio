#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_GOOGLE_include_directive : require

// A body's swept bounds enclose all its triangle queries. Search the body hierarchy once,
// then let those triangles reuse the candidates. Overflow leaves the exact traversal active.
layout(local_size_x = 64) in;

#include "solver_common.glsl"
#include "contact_common.glsl"

void main()
{
    uint p = gl_GlobalInvocationID.x;
    if (p >= rangeCount)
        return;
    uint total = 0u;
    if (bodies[p].info.w == 0u)
    {
        bodyCandidateCounts[p] = 0u;
        return;
    }
    vec3 lower = bodies[p].boundsMin.xyz;
    vec3 upper = bodies[p].boundsMax.xyz;
    uint node = 0u;
    uint end = bodyBvhRefit[0].z;
    while (node < end)
    {
        BvhNode box = bodyBvhNodes[node];
        if (!overlaps(lower, upper, box.boundsMin.xyz, box.boundsMax.xyz))
        {
            node = bodyBvhRefit[node].z;
            continue;
        }
        uint count = floatBitsToUint(box.boundsMax.w);
        uint first = floatBitsToUint(box.boundsMin.w);
        for (uint i = 0u; i < count; i++)
        {
            uint q = bodyBvhPrimitives[first + i];
            if (q == p || !enumeratesAgainst(p, q) || !overlaps(lower, upper, bodies[q].boundsMin.xyz, bodies[q].boundsMax.xyz))
                continue;
            if (total == MAX_BODY_CANDIDATES)
            {
                bodyCandidateCounts[p] = MAX_BODY_CANDIDATES + 1u;
                return;
            }
            bodyCandidates[p * MAX_BODY_CANDIDATES + total++] = q;
        }
        node++;
    }
    bodyCandidateCounts[p] = total;
}
