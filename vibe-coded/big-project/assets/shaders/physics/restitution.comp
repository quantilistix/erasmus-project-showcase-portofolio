#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_GOOGLE_include_directive : require

// Implicit Euler contacts are inelastic, so rigid bodies get their bounce here, after the
// velocities are known. Contacts that pushed this step and were approaching faster than the
// minimum bounce speed at its start are averaged, weighted by how hard each pushed, into one
// impact point (the center of pressure) and normal; an impulse there makes the sides part at
// restitution × the speed they met at. A flat landing so bounces straight, a corner landing
// spins.
//
// Two rigid bodies share a bounce as one impulse between them would: each takes the part of
// the parting speed that its inverse effective mass at the contact is of both sides', so a
// heavy body hardly bounces off a light one, and momentum is kept. Fixed and soft bodies take
// no share. How fast the sides part already comes from how they moved over the step, which
// this pass leaves alone, so no body reads a velocity that another one is writing.
//
// One workgroup per body; its threads split the contacts and sum them in shared memory.

layout(local_size_x = 64) in;

#include "solver_common.glsl"
#include "contact_common.glsl"

const uint GROUP = 64u;

// Per thread: weighted arm xyz, weighted normal xyz, weighted parting speed to add, weight.
const uint TERMS = 8u;

shared float partials[TERMS * GROUP];

// The inverse of rigid body r's effective mass along a direction at a lever arm.
float inverseEffectiveMass(uint r, vec3 arm, vec3 direction)
{
    Rigid body = rigids[r];
    vec3 armCrossDirection = cross(arm, direction);
    return 1.0 / float(body.position.w) + dot(armCrossDirection, rigidInverseWorldInertia(body) * armCrossDirection);
}

void main()
{
    uint r = gl_WorkGroupID.x;
    if (r >= rangeCount)
        return;

    uint thread = gl_LocalInvocationID.x;
    float minimumBounceSpeed = float(limits.z);
    float h = float(gravityAndStep.w);
    uint block = counts.x + r;
    vec3 armSum = vec3(0.0);
    vec3 normalSum = vec3(0.0);
    float increaseSum = 0.0;
    float weightSum = 0.0;

    for (uint ref = blockContactBegin(block) + thread; ref < blockContactEnd(block); ref += GROUP)
    {
        Contact c = contacts[blockContactRefs[ref]];
        float approachSpeed = c.offsetA.w;
        float restitution = c.weightsB.w;
        if (c.lambda.z >= 0.0 || approachSpeed > -minimumBounceSpeed || restitution <= 0.0)
            continue;

        vec3 d = sideDisplacement(contactKindA(c), c.header.y, c.nodesA, c.weightsA, c.offsetA.xyz)
               - sideDisplacement(contactKindB(c), c.header.z, c.nodesB, c.weightsB, c.offsetB.xyz);
        float parting = dot(c.normal.xyz, d) / h;
        float missing = -restitution * approachSpeed - parting;
        if (missing <= 0.0)
            continue;

        float sign;
        vec3 arm;
        rigidContactArm(c, block, sign, arm);

        bool sideA = sign > 0.0;
        float own = inverseEffectiveMass(r, arm, c.normal.xyz);
        float other = 0.0;
        if ((sideA ? contactKindB(c) : contactKindA(c)) == KIND_RIGID)
        {
            uint o = (sideA ? c.header.z : c.header.y) - counts.x;
            other = inverseEffectiveMass(o, rigidCurrentArm(o, sideA ? c.offsetB.xyz : c.offsetA.xyz), c.normal.xyz);
        }

        float weight = -c.lambda.z;
        armSum += weight * arm;
        normalSum += weight * sign * c.normal.xyz;
        increaseSum += weight * missing * own / (own + other);
        weightSum += weight;
    }

    float terms[TERMS] = float[TERMS](armSum.x, armSum.y, armSum.z, normalSum.x, normalSum.y, normalSum.z, increaseSum, weightSum);
    for (uint k = 0u; k < TERMS; k++)
        partials[k * GROUP + thread] = terms[k];

    barrier();

    for (uint stride = GROUP / 2u; stride > 0u; stride >>= 1u)
    {
        if (thread < stride)
        {
            for (uint k = 0u; k < TERMS; k++)
                partials[k * GROUP + thread] += partials[k * GROUP + thread + stride];
        }

        barrier();
    }

    if (thread != 0u)
        return;

    armSum = vec3(partials[0], partials[GROUP], partials[2u * GROUP]);
    normalSum = vec3(partials[3u * GROUP], partials[4u * GROUP], partials[5u * GROUP]);
    increaseSum = partials[6u * GROUP];
    weightSum = partials[7u * GROUP];

    float normalLength = length(normalSum);
    if (weightSum <= 0.0 || normalLength < 1e-12 * weightSum)
        return;

    vec3 arm = armSum / weightSum;
    vec3 normal = normalSum / normalLength;
    float impulse = (increaseSum / weightSum) / inverseEffectiveMass(r, arm, normal);

    Rigid body = rigids[r];
    rigids[r].linearVelocity.xyz += dvec3(impulse * normal / float(body.position.w));
    rigids[r].angularVelocity.xyz += dvec3(rigidInverseWorldInertia(body) * (impulse * cross(arm, normal)));
}
