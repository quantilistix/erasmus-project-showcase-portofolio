#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_GOOGLE_include_directive : require

// Refits the soft bodies' BVHs to this pass's swept triangle bounds, bottom up, one thread per
// node of those BVHs. Each leaf bounds its triangles, then climbs for as long as it is the
// second child of its parent to finish, so every interior node is merged exactly once and
// after both its children. The topology stays as built from the rest shape; deformation only
// loosens the boxes.

#define BVH_NODES_QUALIFIER coherent

layout(local_size_x = 64) in;

#include "solver_common.glsl"
#include "contact_common.glsl"

void main()
{
    if (gl_GlobalInvocationID.x >= rangeCount)
        return;

    uint node = rangeOffset + gl_GlobalInvocationID.x;
    uint count = floatBitsToUint(bvhNodes[node].boundsMax.w);
    if (count == 0u)
        return;

    uint first = floatBitsToUint(bvhNodes[node].boundsMin.w);
    uint firstTriangle = bvhRefit[node - rangeOffset].z;
    vec3 lower = vec3(3.0e38);
    vec3 upper = vec3(-3.0e38);
    for (uint i = 0u; i < count; i++)
    {
        uint t = firstTriangle + bvhPrimitives[first + i];
        lower = min(lower, triangleBounds[2u * t].xyz);
        upper = max(upper, triangleBounds[2u * t + 1u].xyz);
    }

    bvhNodes[node].boundsMin.xyz = lower;
    bvhNodes[node].boundsMax.xyz = upper;

    for (;;)
    {
        uint parent = bvhRefit[node - rangeOffset].x;
        if (parent == NO_BLOCK)
            return;

        memoryBarrierBuffer();
        if (atomicAdd(bvhRefit[parent - rangeOffset].y, 1u) == 0u)
            return;

        memoryBarrierBuffer();
        bvhRefit[parent - rangeOffset].y = 0u;

        uint right = floatBitsToUint(bvhNodes[parent].boundsMin.w);
        bvhNodes[parent].boundsMin.xyz = min(bvhNodes[parent + 1u].boundsMin.xyz, bvhNodes[right].boundsMin.xyz);
        bvhNodes[parent].boundsMax.xyz = max(bvhNodes[parent + 1u].boundsMax.xyz, bvhNodes[right].boundsMax.xyz);
        node = parent;
    }
}
