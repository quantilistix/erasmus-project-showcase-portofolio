#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_GOOGLE_include_directive : require

// One block Gauss-Seidel half sweep on a level (size.w) over the nodes of one color
// (coarseSize.w), whose neighbours are all of the other color; see smoothNode.
// offsets.x, offsets.z = the level's first node and first block node.

layout(local_size_x = 64) in;

#include "lattice_common.glsl"

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    Level level = thisLevel();
    if (i < nodeCount(level.size))
        smoothNode(level, i, pass.coarseSize.w);
}
