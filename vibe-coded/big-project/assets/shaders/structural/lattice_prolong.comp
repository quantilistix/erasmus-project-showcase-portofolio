#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_GOOGLE_include_directive : require

// One thread per node of the finer level; see prolongNode. Same push constants as
// lattice_restrict.comp.

layout(local_size_x = 64) in;

#include "lattice_common.glsl"

void main()
{
    int i = int(gl_GlobalInvocationID.x);
    Level fine = thisLevel();
    if (i < nodeCount(fine.size))
        prolongNode(fine, coarserLevel(), i);
}
