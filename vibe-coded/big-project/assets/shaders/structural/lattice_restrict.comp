#version 450
#extension GL_ARB_gpu_shader_fp64 : enable
#extension GL_GOOGLE_include_directive : require

// One thread per node of the coarser level; see restrictNode. size, coarseSize = the two
// boxes (size.w the finer level); offsets = their first nodes (x, y) and first block nodes (z, w).

layout(local_size_x = 64) in;

#include "lattice_common.glsl"

void main()
{
    int a = int(gl_GlobalInvocationID.x);
    Level coarse = coarserLevel();
    if (a < nodeCount(coarse.size))
        restrictNode(thisLevel(), coarse, a);
}
