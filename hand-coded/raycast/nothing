--cast a 2d ray

function cast(v1, v2, out)
    --local vars
    local t, u, p1, p2

    --get pos amplifiers

    t =
        ((v1.x1 - v2.x1) * (v2.y1 - v2.y2) - (v1.y1 - v2.y1) * (v2.x1 - v2.x2)) /
        ((v1.x1 - v1.x2) * (v2.y1 - v2.y2) - (v1.y1 - v1.y2) * (v2.x1 - v2.x2))
    u =
        ((v1.x1 - v2.x1) * (v1.y1 - v1.y2) - (v1.y1 - v2.y1) * (v1.x1 - v1.x2)) /
        ((v1.x1 - v1.x2) * (v2.y1 - v2.y2) - (v1.y1 - v1.y2) * (v2.x1 - v2.x2))

    --calculate the intersection
    p1 = v1.x1 + t * (v1.x2 - v1.x1)
    p2 = v1.y1 + t * (v1.y2 - v1.y1)

    -- --draw obstacles
    -- love.graphics.line(v2.x1, v2.y1, v2.x2, v2.y2)

    -- --draw rays
    -- if 0 <= t and (0 <= u and u <= 1) then
    --     love.graphics.line(v1.x1, v1.y1, p1, p2)
    -- else
    --     love.graphics.line(v1.x1, v1.y1, v1.x2, v1.y2)
    -- end

    --publish the intersection point
    out.x = p1
    out.y = p2

    --get distance
    if 0 <= t and (0 <= u and u <= 1) then
        out.d = math.sqrt((v1.x1 - p1) ^ 2 + (v1.y1 - p2) ^ 2)
    else
        out.d = 0
    end
end

