l1.x2 = math.cos(0) * 1000
l1.y2 = math.sin(0) * 1000
l1.r = 0
o.x = 0
o.y = 0
o.d = 0
j = 0
function lit()
    j = 0
    for i = -math.pi / 4 + math.rad(l1.r), math.pi / 4 + math.rad(l1.r), math.pi / 3200 do
        l1.x2 = math.cos(i) * 1000 + l1.x1
        l1.y2 = math.sin(i) * 1000 + l1.y1

        cast(l1, l2, o)
        if o.d > 10 then
            love.graphics.line(j * 100, -200 / (o.d / 20) + 300, j * 100, 200 / (o.d / 20) + 300)
        end
        cast(l1, l3, o)
        if o.d > 10 then
            love.graphics.line(j * 100, -200 / (o.d / 20) + 300, j * 100, 200 / (o.d / 20) + 300)
        end

        j = j + 2 / 400
    end
end

function love.draw()
    s = math.sin(math.rad(l1.r))
    c = math.cos(math.rad(l1.r))

    if love.keyboard.isDown("up") == true then
        l1.x1 = l1.x1 + c
        l1.x2 = l1.x2 + c
        l1.y1 = l1.y1 + s
        l1.y2 = l1.y2 + s
    end

    if love.keyboard.isDown("down") == true then
        l1.x1 = l1.x1 - c
        l1.x2 = l1.x2 - c
        l1.y1 = l1.y1 - s
        l1.y2 = l1.y2 - s
    end

    if love.keyboard.isDown("x") == true then
        l1.x1 = l1.x1 - s
        l1.x2 = l1.x2 - s
        l1.y1 = l1.y1 + c
        l1.y2 = l1.y2 + c
    end

    if love.keyboard.isDown("z") == true then
        l1.x1 = l1.x1 + s
        l1.x2 = l1.x2 + s
        l1.y1 = l1.y1 - c
        l1.y2 = l1.y2 - c
    end

    if love.keyboard.isDown("left") == true then
        l1.r = l1.r - 1
    end

    if love.keyboard.isDown("right") == true then
        l1.r = l1.r + 1
    end
    lit()
end
