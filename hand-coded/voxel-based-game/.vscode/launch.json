{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ build & run",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Application", // Path to the executable generated by g++
            "args": [], // Arguments for the program
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build", // Run the build task before launching
            "miDebuggerPath": "/usr/bin/gdb", // Path to gdb
            "logging": {
                "engineLogging": true
            }
        },
        {
            "name": "C++ run",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Application", // Path to the executable generated by g++
            "args": [], // Arguments for the program
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb", // Path to gdb
            "logging": {
                "engineLogging": true
            }
        },
        {
            "name": "C++ build",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/make",
            "args": [
                "build"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": true
            }
        }
    ]
}